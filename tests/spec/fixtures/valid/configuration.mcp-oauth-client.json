{
  "version": "v1",
  "targets": [
    {
      "name": "oauth",
      "type": "mcp",
      "endpoint": "https://example.com/mcp",
      "mcp": {
        "oauth": {
          "issuer": "https://auth.example.com",
          "client_id": "registered-client",
          "grant": "client_credentials",
          "client_secret_env": "MCP_CLIENT_SECRET",
          "scopes": [
            "read"
          ]
        }
      }
    }
  ]
}
