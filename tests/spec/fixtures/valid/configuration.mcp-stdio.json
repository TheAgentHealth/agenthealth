{
  "version": "v1",
  "targets": [
    {
      "name": "local",
      "type": "mcp",
      "endpoint": "stdio://local",
      "mcp": {
        "transport": "stdio",
        "stdio": {
          "command": "python3",
          "args": [
            "server.py"
          ],
          "env": {
            "MCP_TOKEN": "LOCAL_MCP_TOKEN"
          }
        }
      }
    }
  ]
}
