{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheAgentHealth/agenthealth/spec/schemas/configuration.schema.json",
  "title": "AgentHealth Configuration",
  "description": "Schema for agenthealth.yaml. See ../configuration.md.",
  "$defs": {
    "Dimension": {
      "type": "string",
      "enum": ["reachability", "protocol", "authentication", "capability", "functional", "dependency", "latency", "configuration"]
    },
    "Thresholds": {
      "type": "object",
      "properties": {
        "latency_ms": { "type": "number", "minimum": 0 }
      }
    },
    "Dependency": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "endpoint": { "type": "string" },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/Dimension" }
        },
        "thresholds": { "$ref": "#/$defs/Thresholds" },
        "critical": { "type": "boolean", "default": true },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/Dependency" }
        }
      },
      "required": ["name", "type", "endpoint"]
    },
    "Target": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "endpoint": { "type": "string" },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/Dimension" }
        },
        "thresholds": { "$ref": "#/$defs/Thresholds" },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/Dependency" }
        }
      },
      "required": ["name", "type", "endpoint"]
    }
  },
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Target" }
    }
  },
  "required": ["version", "targets"]
}
