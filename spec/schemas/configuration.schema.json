{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheAgentHealth/agenthealth/spec/schemas/configuration.schema.json",
  "title": "AgentHealth Configuration",
  "description": "Schema for agenthealth.yaml. See ../configuration.md.",
  "$defs": {
    "Dimension": {
      "type": "string",
      "enum": [
        "reachability",
        "protocol",
        "authentication",
        "capability",
        "functional",
        "dependency",
        "latency",
        "configuration"
      ]
    },
    "TargetType": {
      "type": "string",
      "enum": [
        "agent",
        "multi-agent",
        "a2a",
        "mcp",
        "tool",
        "model",
        "llm",
        "http",
        "api",
        "vector-store",
        "database",
        "runtime",
        "gateway",
        "custom"
      ]
    },
    "Thresholds": {
      "type": "object",
      "properties": {
        "latency_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Dependency": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/TargetType"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dimension"
          }
        },
        "thresholds": {
          "$ref": "#/$defs/Thresholds"
        },
        "critical": {
          "type": "boolean",
          "default": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000,
          "default": 5000
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0
        },
        "retry_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 100
        },
        "check_timeouts_ms": {
          "type": "object",
          "properties": {
            "reachability": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "protocol": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "authentication": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "capability": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "functional": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "latency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "configuration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          },
          "additionalProperties": false
        },
        "auth": {
          "$ref": "#/$defs/AuthReference"
        },
        "http": {
          "$ref": "#/$defs/HTTPOptions"
        },
        "mcp": {
          "$ref": "#/$defs/MCPOptions"
        },
        "a2a": {
          "$ref": "#/$defs/A2AOptions"
        }
      },
      "required": [
        "name",
        "type",
        "endpoint"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "http"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "http",
                  "api"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "http"
            ],
            "properties": {
              "http": {
                "required": [
                  "body_contains"
                ],
                "properties": {
                  "body_contains": {
                    "minLength": 1
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "checks"
            ],
            "properties": {
              "checks": {
                "contains": {
                  "const": "functional"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "http",
              "checks"
            ],
            "properties": {
              "http": {
                "anyOf": [
                  {
                    "required": [
                      "expected_status"
                    ]
                  },
                  {
                    "required": [
                      "headers"
                    ],
                    "properties": {
                      "headers": {
                        "minProperties": 1
                      }
                    }
                  }
                ]
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "enum": [
                    "protocol",
                    "functional"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mcp"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "mcp"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mcp"
            ],
            "properties": {
              "mcp": {
                "required": [
                  "functional"
                ]
              }
            }
          },
          "then": {
            "required": [
              "checks"
            ],
            "properties": {
              "checks": {
                "contains": {
                  "const": "functional"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type",
              "checks"
            ],
            "properties": {
              "type": {
                "const": "mcp"
              },
              "checks": {
                "contains": {
                  "const": "functional"
                }
              }
            }
          },
          "then": {
            "required": [
              "mcp"
            ],
            "properties": {
              "mcp": {
                "required": [
                  "functional"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mcp",
              "checks"
            ],
            "properties": {
              "mcp": {
                "anyOf": [
                  {
                    "required": [
                      "required_tools"
                    ],
                    "properties": {
                      "required_tools": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "required": [
                      "required_resources"
                    ],
                    "properties": {
                      "required_resources": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "required": [
                      "required_prompts"
                    ],
                    "properties": {
                      "required_prompts": {
                        "minItems": 1
                      }
                    }
                  }
                ]
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "const": "capability"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mcp"
            ],
            "properties": {
              "mcp": {
                "anyOf": [
                  {
                    "required": [
                      "oauth"
                    ]
                  },
                  {
                    "required": [
                      "transport"
                    ],
                    "properties": {
                      "transport": {
                        "const": "stdio"
                      }
                    }
                  }
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "auth"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "a2a"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "a2a"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "a2a"
            ],
            "properties": {
              "a2a": {
                "required": [
                  "functional"
                ]
              }
            }
          },
          "then": {
            "required": [
              "checks"
            ],
            "properties": {
              "checks": {
                "contains": {
                  "const": "functional"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type",
              "checks"
            ],
            "properties": {
              "type": {
                "const": "a2a"
              },
              "checks": {
                "contains": {
                  "const": "functional"
                }
              }
            }
          },
          "then": {
            "required": [
              "a2a"
            ],
            "properties": {
              "a2a": {
                "required": [
                  "functional"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "a2a",
              "checks"
            ],
            "properties": {
              "a2a": {
                "anyOf": [
                  {
                    "required": [
                      "required_skills"
                    ],
                    "properties": {
                      "required_skills": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "required": [
                      "required_capabilities"
                    ],
                    "properties": {
                      "required_capabilities": {
                        "minItems": 1
                      }
                    }
                  }
                ]
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "const": "capability"
                }
              }
            }
          }
        }
      ]
    },
    "Target": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/TargetType"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dimension"
          }
        },
        "thresholds": {
          "$ref": "#/$defs/Thresholds"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000,
          "default": 5000
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0
        },
        "retry_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 100
        },
        "check_timeouts_ms": {
          "type": "object",
          "properties": {
            "reachability": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "protocol": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "authentication": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "capability": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "functional": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "latency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "configuration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          },
          "additionalProperties": false
        },
        "auth": {
          "$ref": "#/$defs/AuthReference"
        },
        "http": {
          "$ref": "#/$defs/HTTPOptions"
        },
        "mcp": {
          "$ref": "#/$defs/MCPOptions"
        },
        "a2a": {
          "$ref": "#/$defs/A2AOptions"
        }
      },
      "required": [
        "name",
        "type",
        "endpoint"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "http"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "http",
                  "api"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "http"
            ],
            "properties": {
              "http": {
                "required": [
                  "body_contains"
                ],
                "properties": {
                  "body_contains": {
                    "minLength": 1
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "checks"
            ],
            "properties": {
              "checks": {
                "contains": {
                  "const": "functional"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "http",
              "checks"
            ],
            "properties": {
              "http": {
                "anyOf": [
                  {
                    "required": [
                      "expected_status"
                    ]
                  },
                  {
                    "required": [
                      "headers"
                    ],
                    "properties": {
                      "headers": {
                        "minProperties": 1
                      }
                    }
                  }
                ]
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "enum": [
                    "protocol",
                    "functional"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mcp"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "mcp"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mcp"
            ],
            "properties": {
              "mcp": {
                "required": [
                  "functional"
                ]
              }
            }
          },
          "then": {
            "required": [
              "checks"
            ],
            "properties": {
              "checks": {
                "contains": {
                  "const": "functional"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type",
              "checks"
            ],
            "properties": {
              "type": {
                "const": "mcp"
              },
              "checks": {
                "contains": {
                  "const": "functional"
                }
              }
            }
          },
          "then": {
            "required": [
              "mcp"
            ],
            "properties": {
              "mcp": {
                "required": [
                  "functional"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mcp",
              "checks"
            ],
            "properties": {
              "mcp": {
                "anyOf": [
                  {
                    "required": [
                      "required_tools"
                    ],
                    "properties": {
                      "required_tools": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "required": [
                      "required_resources"
                    ],
                    "properties": {
                      "required_resources": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "required": [
                      "required_prompts"
                    ],
                    "properties": {
                      "required_prompts": {
                        "minItems": 1
                      }
                    }
                  }
                ]
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "const": "capability"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mcp"
            ],
            "properties": {
              "mcp": {
                "anyOf": [
                  {
                    "required": [
                      "oauth"
                    ]
                  },
                  {
                    "required": [
                      "transport"
                    ],
                    "properties": {
                      "transport": {
                        "const": "stdio"
                      }
                    }
                  }
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "auth"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "a2a"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "a2a"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "a2a"
            ],
            "properties": {
              "a2a": {
                "required": [
                  "functional"
                ]
              }
            }
          },
          "then": {
            "required": [
              "checks"
            ],
            "properties": {
              "checks": {
                "contains": {
                  "const": "functional"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type",
              "checks"
            ],
            "properties": {
              "type": {
                "const": "a2a"
              },
              "checks": {
                "contains": {
                  "const": "functional"
                }
              }
            }
          },
          "then": {
            "required": [
              "a2a"
            ],
            "properties": {
              "a2a": {
                "required": [
                  "functional"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "a2a",
              "checks"
            ],
            "properties": {
              "a2a": {
                "anyOf": [
                  {
                    "required": [
                      "required_skills"
                    ],
                    "properties": {
                      "required_skills": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "required": [
                      "required_capabilities"
                    ],
                    "properties": {
                      "required_capabilities": {
                        "minItems": 1
                      }
                    }
                  }
                ]
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "const": "capability"
                }
              }
            }
          }
        }
      ]
    },
    "AuthReference": {
      "type": "object",
      "properties": {
        "bearer_env": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^=\\u0000]+$",
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        }
      },
      "required": [
        "bearer_env"
      ],
      "additionalProperties": false
    },
    "HTTPOptions": {
      "type": "object",
      "properties": {
        "expected_status": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 200,
            "maximum": 599
          }
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^\\u0000-\\u0008\\u000a-\\u001f\\u007f]*$"
          }
        },
        "body_contains": {
          "type": "string"
        },
        "max_body_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "additionalProperties": false
    },
    "MCPOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "enum": [
            "",
            "2025-03-26",
            "2025-06-18",
            "2025-11-25",
            "2026-07-28"
          ]
        },
        "required_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required_resources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required_prompts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "functional": {
          "$ref": "#/$defs/MCPInvocation"
        },
        "transport": {
          "enum": [
            "",
            "http",
            "stdio"
          ]
        },
        "stdio": {
          "$ref": "#/$defs/MCPStdio"
        },
        "oauth": {
          "$ref": "#/$defs/MCPOAuth"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "transport"
            ],
            "properties": {
              "transport": {
                "const": "stdio"
              }
            }
          },
          "then": {
            "required": [
              "stdio"
            ],
            "not": {
              "required": [
                "oauth"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "stdio"
              ]
            }
          }
        }
      ]
    },
    "MCPInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "safe"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "safe": {
          "const": true
        },
        "arguments_json": {
          "type": "string",
          "maxLength": 65536,
          "description": "Empty or a JSON object; the Go loader additionally parses and validates this string."
        }
      }
    },
    "MCPStdio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\\u0000]*$"
            }
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]*$"
          }
        },
        "directory": {
          "type": "string",
          "pattern": "^[^\\u0000]*$"
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^=\\u0000]+$",
            "allOf": [
              {
                "pattern": "\\S"
              }
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^=\\u0000]+$",
            "allOf": [
              {
                "pattern": "\\S"
              }
            ]
          }
        }
      }
    },
    "MCPOAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "client_id",
        "grant"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "grant": {
          "enum": [
            "client_credentials",
            "refresh_token",
            "authorization_code"
          ]
        },
        "client_secret_env": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^=\\u0000]+$",
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "refresh_token_env": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^=\\u0000]+$",
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "token_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\\u0000]*$"
            }
          ]
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[\\u0021\\u0023-\\u005b\\u005d-\\u007e]+$"
          }
        },
        "redirect_port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "grant": {
                "const": "client_credentials"
              }
            }
          },
          "then": {
            "required": [
              "client_secret_env"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "grant": {
                "const": "refresh_token"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "refresh_token_env"
                ]
              },
              {
                "required": [
                  "token_file"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "grant": {
                "const": "authorization_code"
              }
            }
          },
          "then": {
            "required": [
              "token_file"
            ]
          }
        }
      ]
    },
